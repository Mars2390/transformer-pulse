// ---------------------------------------------------------------------------
// Transformer Pulse — data model
//
// The governing rule: a transformer's CURRENT STATE is derived from an
// APPEND-ONLY chain of lifecycle events. We never edit history. If a
// transformer moves, that is a new event — not an UPDATE to an old one.
//
// This is what lets every transformer tell its story, and what makes the
// record hold up when a manufacturer disputes a warranty claim.
// ---------------------------------------------------------------------------

generator client {
  // Prisma 7: the generator is "prisma-client" (not "prisma-client-js") and
  // `output` is required. The client is no longer written into node_modules,
  // so we import it from this path — never from "@prisma/client".
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  // Prisma 7 removed `url` from this block. The connection string now lives in
  // prisma.config.ts for the CLI (migrate), and reaches the client at runtime
  // through the driver adapter in src/lib/prisma.ts.
  provider = "postgresql"
}

// ============================== Enums ======================================

enum Role {
  ADMIN // creates users, manages manufacturers
  MANAGER // the one-way mirror — reads everything, writes nothing
  STORE_KEEPER // receives, tests, dispatches
  FIELD_ENGINEER // installs, inspects, reports faults
}

enum TransformerStatus {
  IN_STORE // received at a KPLC store, G-Number assigned
  IN_TRANSIT // on a vehicle, between two places
  IN_FIELD // energised at a site
  FAULTY // failed in service, still on the pole

  // --- The repair loop -----------------------------------------------------
  // AT_WORKSHOP is the live status — distinct from IN_STORE, matching KPLC's
  // actual chain of custody (a workshop is a different physical place with a
  // different custodian than a store). IN_REPAIR is kept, unused, purely so
  // any historical row still carrying it stays valid; nothing new is ever
  // written with it after the one-time data migration to AT_WORKSHOP.
  AT_WORKSHOP // recovered from the field, at a workshop
  IN_REPAIR // deprecated — superseded by AT_WORKSHOP, see above
  REPAIRED // work complete and tested, ready to go back to a store
  BEYOND_REPAIR // opened, diagnosed, and not economically repairable

  // A site is off supply and no unit of the right rating is free. This is the
  // status that makes a procurement gap visible instead of invisible.
  AWAITING_REPLACEMENT

  RETURNED // sent back to the manufacturer
  SCRAPPED // written off
}

enum SupplyRequestReason {
  TRANSFORMER_FAILED // the unit that was there is gone or dead
  NO_SUPPLY_AT_SITE // an area that has never had one
  CAPACITY_UPGRADE // existing unit too small for the load
  RELOCATION
}

enum SupplyUrgency {
  NORMAL
  HIGH
  EMERGENCY // customers off supply now
}

enum SupplyRequestStatus {
  SUBMITTED // raised by a field engineer
  APPROVED // a manager authorised it
  REJECTED
  ALLOCATED // a specific transformer is reserved against it
  FULFILLED // energised on site
  CANCELLED
}

/**
 * Where a transformer's COORDINATES came from — a different question from where
 * its record came from.
 * A pin placed by someone standing under the transformer and a pin derived from
 * the words "Wanyee rd" are both dots on a map, and a map that draws them
 * identically is lying by omission. Every view colours by this.
 */
enum PositionSource {
  SURVEYED // a GPS fix taken at the asset
  GEOCODED // derived from a written landmark. 50-200 m at best.
  UNAVAILABLE // no usable location text; cannot be placed at all
}

enum AllocationStatus {
  RESERVED // held for this site, not yet dispatched
  DISPATCHED // on a vehicle
  INSTALLED // energised; the request is satisfied
  RELEASED // the hold was given up, the unit is free again
}

enum EventType {
  RECEIVED_AT_STORE // genesis for a unit that enters through a KPLC store

  // Genesis for a unit that was ALREADY on a pole before the system existed.
  // KPLC has tens of thousands of these. They never passed through a store we
  // have a record of, so their chain starts where we found them.
  ONBOARDED_EXISTING

  TESTED
  DISPATCHED // leaves the store on a vehicle
  RECEIVED_BY_FIELD // field engineer confirms it arrived
  INSTALLED // energised — this is where the GPS pin is born
  INSPECTED

  // An EMDis load export was ingested against this transformer. A load check is
  // something that HAPPENED to the asset, so it belongs on the chain next to
  // the dispatches and inspections rather than in a side table.
  LOAD_CHECK_RECORDED

  FAULT_REPORTED
  RECOVERED // removed from site

  // --- The repair loop -----------------------------------------------------
  RECOVERED_FOR_REPAIR // taken off the pole with the workshop as its destination
  RECEIVED_AT_WORKSHOP
  REPAIR_STARTED
  REPAIRED // work finished and proved by test
  REPAIR_FAILED // opened and condemned
  DISPOSED // scrapped after a failed repair

  // No unit of this rating is free. Recorded as an event so the waiting has a
  // start time and the outage can be measured, not estimated.
  AWAITING_REPLACEMENT

  RETURNED_TO_MANUFACTURER
  SCRAPPED
}

enum TestStage {
  STORE_INTAKE
  PRE_DISPATCH
  SITE_COMMISSIONING
  ROUTINE
  POST_FAULT

  // Insulation and winding resistance measured at the pole, on a unit already
  // in service. Not tied to intake or commissioning — an engineer went out
  // specifically to test it.
  FIELD_DIAGNOSTIC
}

/**
 * How a measurement that should be a number came back.
 * An earth tester reading "OL" is NOT missing data. KPLC confirm it means OVER
 * RANGE: the resistance is beyond what the instrument can measure, which in
 * practice means there is no effective earth. Storing that as null loses a
 * safety defect; storing it as text loses it from every report.
 */
enum MeasurementState {
  MEASURED // a real number is present
  OPEN_CIRCUIT // tester read OL (over range) — no effective earth
  VANDALISED // earth conductor stolen or cut
  NOT_MEASURED // nobody carried a tester; an honest blank
}

enum StructureCondition {
  OKAY
  LEANING
  ROTTEN
}

enum FuseCarrierState {
  OKAY
  NEEDS_REPLACEMENT
}

enum FuseBarType {
  WOODEN
  STEADY_BAR
  FUSE_CARRIERS_ON_POLE
  PLASTIC // the file spells this "plasctic"
}

/**
 * What the inspector prescribed when loading was not okay.
 */
enum LoadAction {
  PHASE_BALANCING
  RELIEVE
  ADDITIONAL_CIRCUIT
  UPRATE
  DERATE
}

/**
 * How an imported row found its transformer — recorded so the join is auditable.
 */
enum MatchMethod {
  G_NUMBER
  SERIAL
  SUBSTATION_CODE
  MANUAL
  UNRESOLVED
}

enum ImportKind {
  INSPECTION
  EMDIS
}

enum McpTokenKind {
  OAUTH // issued through the browser consent flow
  MANUAL // generated directly from the settings page
}

enum McpAuthMethod {
  OAUTH
  API_KEY
  NONE
}

enum ConflictStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ClaimStatus {
  OPEN // fault recorded, claim not yet sent
  SUBMITTED // sent to the manufacturer
  APPROVED // manufacturer accepted liability
  REJECTED
  CLOSED // replacement or credit received
}

enum AlertType {
  FAULT_REPORTED
  WARRANTY_EXPIRING
  INSPECTION_OVERDUE
  REPEAT_FAILURE
  // Scanned far from its registered site: a move nobody recorded, or a theft.
  GPS_MISMATCH
  // Failed its intake test — it should go back before it ever reaches a pole.
  INTAKE_TEST_FAILED
  // A transformer was energised in the field — good news, shown to the manager.
  INSTALLED

  // --- From EMDis load telemetry -------------------------------------------
  // One phase exceeded its rated current. This is invisible in the kVA figure:
  // a unit can sit at 71% of nameplate while a single phase runs at 121%.
  SINGLE_PHASE_OVERLOAD
  PHASE_UNBALANCE
  NEUTRAL_CURRENT_HIGH
  THD_HIGH

  // --- From substation inspections -----------------------------------------
  EARTH_OPEN // tester read OL (over range) — no effective earth
  EARTH_HIGH
  STRUCTURE_DEFECT // pole rotten or leaning

  // --- From field diagnostics ----------------------------------------------
  IR_LOW
  WR_DEVIATION

  // --- Repair and replacement ----------------------------------------------
  REPAIR_COMPLETED
  REPAIR_FAILED
  AWAITING_REPLACEMENT // a site is off supply with nothing to give it
  STOCK_LOW // a rating is running out before it runs out
  SUPPLY_REQUEST_RAISED
  ALLOCATION_OVERDUE // reserved, install date passed, still not energised
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

// ============================== People =====================================

model User {
  id          String  @id @default(cuid())
  name        String
  email       String  @unique
  phone       String?
  staffNumber String? @unique

  // A 6-digit PIN, bcrypt-hashed. We never store the PIN itself, so a database
  // leak does not hand over anyone's login.
  pinHash String
  role    Role   @default(FIELD_ENGINEER)

  // Scopes what a manager sees and where a field engineer works.
  region String?

  // Which warehouse a store keeper belongs to.
  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id])

  // --- Brute-force protection ---------------------------------------------
  // Six digits is a million combinations — trivial for a script without these.
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?

  active        Boolean   @default(true)
  // Set true after an admin resets the PIN, so the user is nudged to change it.
  mustChangePin Boolean   @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  events             LifecycleEvent[]
  tests              TestRecord[]
  claimsRaised       WarrantyClaim[]  @relation("ClaimRaisedBy")
  alertsAcknowledged Alert[]          @relation("AlertAcknowledgedBy")
  auditEntries       AuditLog[]       @relation("AuditActor")

  // KPLC data operations
  inspectionsCarriedOut SubstationInspection[] @relation("InspectionInspector")
  conflictsResolved     RecordConflict[]       @relation("ConflictResolver")
  importsUploaded       ImportBatch[]          @relation("ImportUploader")

  supplyRequestsRaised   SupplyRequest[] @relation("SupplyRaisedBy")
  supplyRequestsApproved SupplyRequest[] @relation("SupplyApprovedBy")
  allocationsMade        Allocation[]    @relation("AllocatedBy")

  fatReportsUploaded Transformer[] @relation("FatReportUploadedBy")

  mcpSettingsUpdates McpSettings[]  @relation("McpSettingsUpdatedBy")
  mcpTokensIssued    McpToken[]     @relation("McpTokenIssuedTo")
  mcpAccessLogs      McpAccessLog[] @relation("McpAccessLogUser")

  @@index([role])
  @@index([region])
}

// -------------------------- Admin audit trail -------------------------------
// A record of every administrative EDIT/DELETE/RESTORE — users, manufacturers,
// stores. This is SEPARATE from the LifecycleEvent chain, which no admin action
// ever writes: the custody chain stays append-only and untouched. This table
// answers "who changed this account, and when", not "what happened to a
// transformer".
model AuditLog {
  id      String @id @default(cuid())
  actorId String
  actor   User   @relation("AuditActor", fields: [actorId], references: [id])

  action      String // CREATE | EDIT | DISABLE | ENABLE | UNLOCK | RESET_PIN | DELETE
  targetType  String // User | Manufacturer | Store
  targetId    String
  targetLabel String // human-readable name at the time, so it survives deletion
  details     String? // "Changed role from FIELD_ENGINEER to MANAGER"
  reason      String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model Store {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  region    String
  county    String
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())

  users        User[]
  transformers Transformer[]
}

model Manufacturer {
  id           String  @id @default(cuid())
  name         String  @unique
  country      String?
  contactName  String?
  contactEmail String?
  contactPhone String?

  // Default warranty length for units from this supplier. Copied onto each
  // transformer at registration, so renegotiating a contract later cannot
  // silently rewrite the warranty of units already in the field.
  warrantyMonths Int @default(24)

  createdAt DateTime @default(now())

  transformers Transformer[]
  claims       WarrantyClaim[]
}

// ============================ The asset ====================================

model Transformer {
  id String @id @default(cuid())

  // --- Identity -----------------------------------------------------------
  // From the manufacturer. Never changes.
  serialNumber String @unique

  // Assigned by the KPLC store. Nullable on purpose: that null is exactly the
  // gap where paper loses transformers today — arrived, not yet booked in.
  gNumber String? @unique

  manufacturerId String
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id])

  // --- Nameplate ----------------------------------------------------------
  ratingKva         Int // 50, 100, 200, 315, 500 ...
  primaryKv         Float   @default(11)
  secondaryKv       Float   @default(0.415)
  phases            Int     @default(3)
  coolingType       String  @default("ONAN")
  impedancePct      Float?
  vectorGroup       String? // e.g. Dyn11
  oilVolumeLitres   Int?
  yearOfManufacture Int

  // --- Full nameplate (all optional — added after the first units were
  // registered, so existing records stay valid and are backfilled by edit) ---
  frequencyHz         Int?    @default(50)
  duty                String? // CONT (continuous), etc.
  standardRef         String? // IEC 60076
  hvInsulationLevelKv String? // BIL, e.g. "125/50"
  tempRiseOilC        Int? // top-oil temperature rise
  tempRiseWindingC    Int? // winding temperature rise
  tempClass           String? // insulation temperature class, e.g. "A"
  maxAmbientTempC     Int?
  insulationOilType   String? // e.g. Nytro 10GBNP
  oilWeightKg         Int?
  totalWeightKg       Int?
  tapRange            String? // off-circuit tap voltages, free text

  // --- Warranty -----------------------------------------------------------
  warrantyMonths Int @default(24)

  // The clock starts when KPLC takes delivery, NOT at manufacture. A unit that
  // sat in a container for eight months has not burned eight months of cover.
  // Paper gets this wrong, always in the manufacturer's favour.
  warrantyStart DateTime?

  // --- Documents ------------------------------------------------------------
  // Just the FAT report for now — one slot, not a general attachments table.
  // Add a proper Document model if/when a second document type is needed.
  fatReportUrl          String?
  fatReportUploadedAt   DateTime?
  fatReportUploadedById String?
  fatReportUploadedBy   User?     @relation("FatReportUploadedBy", fields: [fatReportUploadedById], references: [id])

  // --- Current state (a cache of the event chain, for fast queries) --------
  status TransformerStatus @default(IN_STORE)

  currentStoreId String?
  currentStore   Store?  @relation(fields: [currentStoreId], references: [id])

  currentLat      Float?
  currentLng      Float?
  currentSiteName String?
  sdb             String? // sub-distribution board / substation reference
  feeder          String? // e.g. KBT-11kV-04
  region          String?
  county          String?

  commissionDate DateTime? // first energised

  // --- Provenance ---------------------------------------------------------
  // Where this record's position came from. Null means it entered through the
  // normal store flow, where the GPS pin was born at installation and is
  // therefore surveyed by definition.
  //
  // This is what keeps the map honest: a pin dropped from an office chair and
  // a pin dropped standing under the transformer are not the same claim, and
  // the map must not present them as though they were.
  dataSource String? // OSM_SURVEYED | OSM_INFERRED | MANUAL_PIN

  // How it is mounted. Only known for onboarded units, where the keeper can
  // see it; for store units it is not established until installation.
  mountingType String? // POLE_MOUNTED | GROUND_MOUNTED | PAD_MOUNTED | SUBSTATION

  // Set the first time a field engineer physically inspects the unit. Until
  // then an onboarded record is a claim about the world, not a confirmation of
  // it, and the map legend says so.
  verifiedAt DateTime?

  /**
   * How the coordinates above were obtained. Drives the map pin.
   */
  positionSource     PositionSource?
  /**
   * Best-case accuracy in metres, for the popup. Geocoding is 50-200 m.
   */
  positionAccuracyM  Int?
  /**
   * The text a geocode was derived from, so a wrong pin can be traced.
   */
  positionSourceText String?

  // --- KPLC's own identifier ----------------------------------------------
  // How Kenya Power actually refers to these assets in the field: "14537 - LEE
  // PIC ACADEMY". Both the EMDis export and the inspection register carry it,
  // and the EMDis file carries NO G-Number — so this is the only key that lets
  // load telemetry find its transformer.
  substationCode String?
  substationName String?

  // --- Cached condition (a view over inspections and load data) ------------
  // Denormalised for the same reason `status` is: the register and the map
  // would otherwise run a subquery per row.
  lastInspectionAt   DateTime?
  structureCondition StructureCondition?

  // 0-100, higher is healthier. NULL means "not measured", which is not the
  // same as 100 and must never be displayed as though it were.
  electricalStressScore  Int?
  physicalConditionScore Int?

  // Drives the repair list. Recomputed whenever either score changes.
  priorityRank Int?

  inspections   SubstationInspection[]
  emdisDatasets EmdisDataset[]
  emdisHourly   EmdisHourly[]
  conflicts     RecordConflict[]

  repairs             RepairRecord[]
  allocations         Allocation[]
  replacementRequests SupplyRequest[] @relation("ReplacementFor")

  /**
   * How many times this unit has been through a workshop. A transformer on
   * its third repair is telling you something a single record cannot.
   */
  repairCount Int @default(0)

  // Hash of the most recent event. The chain's head — see lib/chain.ts.
  lastEventHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events LifecycleEvent[]
  tests  TestRecord[]
  claims WarrantyClaim[]
  alerts Alert[]

  @@index([status])
  @@index([region])
  @@index([manufacturerId])
  @@index([currentLat, currentLng])
  @@index([substationCode])
  @@index([priorityRank])
  @@index([lastInspectionAt])
}

// ========================= The story itself ================================

model LifecycleEvent {
  repairsOpened RepairRecord[] @relation("RepairOpenedBy")

  id            String      @id @default(cuid())
  transformerId String
  transformer   Transformer @relation(fields: [transformerId], references: [id], onDelete: Cascade)

  type       EventType
  fromStatus TransformerStatus?
  toStatus   TransformerStatus

  // --- Who ----------------------------------------------------------------
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // --- When ---------------------------------------------------------------
  // These are two different facts and must not be collapsed into one column.
  // An engineer records an install at 14:00 with no signal; it reaches us at
  // 19:00. Both are true.
  occurredAt DateTime
  createdAt  DateTime @default(now())

  // --- Where --------------------------------------------------------------
  lat          Float?
  lng          Float?
  accuracyM    Float? // GPS accuracy the phone reported
  locationName String?

  // --- How it moved -------------------------------------------------------
  vehiclePlate String?
  driverName   String?
  driverPhone  String?
  destination  String?

  // --- Evidence -----------------------------------------------------------
  photoUrls String[] // Vercel Blob URLs
  notes     String?

  // --- Tamper-evident chain ------------------------------------------------
  // hash = sha256(prevHash + canonical contents). Editing an old row breaks
  // every hash after it, and /api/transformers/[id]/verify says so.
  prevHash String?
  hash     String  @unique

  // --- Offline idempotency --------------------------------------------------
  // The phone generates this UUID before the event is queued offline. If it
  // syncs, loses signal before hearing the 200, and retries, this unique index
  // is what stops a duplicate event being written — and a duplicate event
  // corrupts the hash chain, which is the one thing we cannot allow.
  clientEventId String? @unique

  // --- Replacement linking -------------------------------------------------
  // When a faulty unit is swapped, the old unit's RECOVERED event and the new
  // unit's INSTALLED event point at each other. That is how the manager sees
  // "this replaced that" without a separate table.
  linkedEventId String?         @unique
  linkedEvent   LifecycleEvent? @relation("EventLink", fields: [linkedEventId], references: [id])
  linkedBy      LifecycleEvent? @relation("EventLink")

  tests TestRecord[]

  @@index([transformerId, occurredAt])
  @@index([type])
}

// ============================= Testing =====================================

model TestRecord {
  postRepairFor RepairRecord[] @relation("PostRepairTest")

  id            String      @id @default(cuid())
  transformerId String
  transformer   Transformer @relation(fields: [transformerId], references: [id], onDelete: Cascade)

  // A test almost always happens as part of an event (intake, dispatch,
  // commissioning), but may be recorded standalone.
  eventId String?
  event   LifecycleEvent? @relation(fields: [eventId], references: [id])

  stage TestStage

  testedById String
  testedBy   User   @relation(fields: [testedById], references: [id])

  // --- Measurements. All nullable: not every stage runs every test. --------
  insulationResistanceHvMohm Float? // HV to earth, megaohms
  insulationResistanceLvMohm Float? // LV to earth, megaohms
  turnsRatio                 Float?
  turnsRatioDeviationPct     Float? // vs nameplate; over 0.5% is a fail
  windingResistanceHvOhm     Float?
  windingResistanceLvOhm     Float?
  oilBdvKv                   Float? // oil breakdown voltage; under 30 kV is a fail
  oilTempC                   Float?
  ambientTempC               Float?
  polarityOk                 Boolean?

  // --- What makes an insulation reading comparable -------------------------
  // Without these, IR is a number that cannot be trended and should not be.

  // A 500 V megger and a 5 kV megger do not produce comparable readings on the
  // same winding. Recording the test voltage is what makes two dates arguable.
  irTestVoltageV Int?

  // 60 s spot reading vs a 10 minute soak. Different measurements.
  irDurationSec Int?

  // IR(10 min) / IR(1 min). The actual diagnostic: below 1.0 means the
  // insulation is absorbing moisture, and it catches problems that a single
  // healthy-looking megohm figure hides completely.
  polarizationIndex Float?

  // Insulation resistance roughly HALVES for every 10 C rise. A reading taken
  // at noon and one taken at dawn differ by 3x on the same healthy transformer.
  // Trending uncorrected IR produces confident nonsense, so the winding
  // temperature is required whenever IR is recorded.
  windingTempC Float?

  // IR normalised to 20 C. Computed on save from windingTempC — this is the
  // figure that gets trended and compared against thresholds.
  irCorrectedTo20C Float?

  passed   Boolean
  remarks  String?
  testedAt DateTime @default(now())

  @@index([transformerId, testedAt])
}

// ============================ Warranty =====================================

model WarrantyClaim {
  id            String      @id @default(cuid())
  transformerId String
  transformer   Transformer @relation(fields: [transformerId], references: [id], onDelete: Cascade)

  manufacturerId String
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id])

  raisedById String
  raisedBy   User   @relation("ClaimRaisedBy", fields: [raisedById], references: [id])

  status      ClaimStatus @default(OPEN)
  faultReason String

  // What KPLC recovers if the manufacturer honours the claim. This is the
  // number that turns a dashboard into a budget line.
  claimValueKes Decimal? @db.Decimal(14, 2)

  referenceNo     String? // the manufacturer's RMA reference
  submittedAt     DateTime?
  resolvedAt      DateTime?
  resolutionNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ==================== Smart-meter data (control room) ======================
// A replayable day of interval data from the meters fed by one transformer.
// Kept separate from the lifecycle chain: this is telemetry, not custody.

model MeterDataset {
  id             String   @id @default(cuid())
  name           String
  transformerRef String? // G-Number the data belongs to, free text
  ratingKva      Int      @default(200)
  meterCount     Int
  intervalCount  Int
  batchSize      Int      @default(200)
  uploadedById   String
  uploadedByName String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  readings MeterReading[]
}

model MeterReading {
  // An Int identity, not a cuid: a single upload is ~96,000 rows and a 25-byte
  // random id on every one of them is pure overhead for data we only ever read
  // back by (dataset, interval, batch).
  id        Int          @id @default(autoincrement())
  datasetId String
  dataset   MeterDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  intervalIndex Int // 0..95 for a 24-hour day at 15-minute intervals
  batchIndex    Int // 0..4 — which group of 200 meters
  meterId       String
  timestamp     DateTime
  voltage       Float
  current       Float
  power         Float // kW
  powerFactor   Float

  @@index([datasetId, intervalIndex, batchIndex])
}

// ============================= Alerts ======================================

model Alert {
  id            String      @id @default(cuid())
  transformerId String
  transformer   Transformer @relation(fields: [transformerId], references: [id], onDelete: Cascade)

  type     AlertType
  severity AlertSeverity @default(WARNING)
  message  String

  // Denormalised so a manager's alert list is one indexed query.
  region String?

  acknowledged     Boolean   @default(false)
  acknowledgedById String?
  acknowledgedBy   User?     @relation("AlertAcknowledgedBy", fields: [acknowledgedById], references: [id])
  acknowledgedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([acknowledged, severity])
  @@index([region])
}

// ============================================================================
// KPLC OPERATIONAL DATA
//
// Two real KPLC sources, joined to the register:
//
//   SubstationInspection — what a lineman can see from the ground. Once or
//   twice a year, 30 fields, human judgement. Answers "can it survive?"
//
//   EmdisReading — what the meter records. Every 60 seconds, 18 electrical
//   quantities, three phases. Answers "how hard is it working?"
//
// Neither is sufficient alone. A transformer in perfect condition is destroyed
// by phase imbalance; a lightly loaded one still falls off a rotten pole.
// ============================================================================

/**
 * One inspection visit. APPEND-ONLY: a later visit never overwrites an earlier
 * one, because the disagreements between visits are themselves the finding.
 * In the first 1,536 real records, 266 transformers were inspected more than
 * once and 82 of those visits disagree about the make or the rating — twice on
 * the same day by different inspectors. Paper cannot disagree with itself, so
 * both filings simply stand. This table lets them disagree in the open.
 */
model SubstationInspection {
  id String @id @default(cuid())

  // KPLC's own report number. Unique, so re-uploading a file is a no-op rather
  // than a duplicate — the natural idempotency key.
  reportId Int @unique

  inspectedOn DateTime

  // Nullable on purpose. A row whose transformer is not on the register yet is
  // STAGED, never dropped and never used to auto-create an asset: the source
  // has 66% serial coverage and G-Numbers reading "Defaced", so auto-creation
  // would manufacture duplicates against the real register.
  transformerId String?
  transformer   Transformer? @relation(fields: [transformerId], references: [id])
  matchedBy     MatchMethod  @default(UNRESOLVED)

  // "14537 - LEE PIC ACADEMY" arrives as one field; split on ingest.
  substationCode String
  substationName String?
  region         String?
  county         String?

  // KPLC staff number as written on the form (e.g. KPL52857). Resolved to a
  // User only if one exists — the register must import without every inspector
  // having an account first.
  inspectorRef    String
  inspectorUserId String?
  inspectorUser   User?   @relation("InspectionInspector", fields: [inspectorUserId], references: [id])

  // --- Identity AS RECORDED ON THE FORM ------------------------------------
  // Never written back to Transformer by the importer. These are what one
  // inspector claimed on one day; Transformer holds what was RESOLVED. Letting
  // the last upload win is exactly the failure mode this replaces.
  serialAsRecorded    String?
  gNumberAsRecorded   String?
  makeAsRecorded      String?
  ratingKvaAsRecorded Int?
  yomAsRecorded       Int?
  voltageKv           Int?

  // --- Protection -----------------------------------------------------------
  fuseSizeA    Int?
  circuits     Int?
  fuseCarriers FuseCarrierState?
  fuseBarType  FuseBarType?

  // --- Earthing (OHMS — earth resistance, NOT insulation resistance) --------
  // Worth stating plainly because the two are easy to confuse and an engineer
  // will not forgive it: insulation resistance is megohms, winding to earth.
  // This is the resistance of the earth electrode itself, in single ohms.
  hvEarthOhm         Float?
  hvEarthState       MeasurementState @default(NOT_MEASURED)
  neutralEarthOhm    Float?
  neutralEarthState  MeasurementState @default(NOT_MEASURED)
  surgeArresterOhm   Float?
  surgeArresterState MeasurementState @default(NOT_MEASURED)
  gapsetMm           Float?

  // --- Conductors -----------------------------------------------------------
  lvConductorMm2 Int?
  leadSizeMm2    Int?

  // --- Loading, as judged by eye and experience -----------------------------
  // The single most valuable column in the file. On substation 14537 an
  // inspector recorded loadingOk=false, loadAction=RELIEVE on 28 Nov 2025. The
  // EMDis meter data nine days later measured a phase at 121% of rated while
  // the kVA figure read 71%. He was right, and nothing in KPLC could show it.
  loadingOk  Boolean?
  loadAction LoadAction?

  // --- Physical condition ---------------------------------------------------
  structure    StructureCondition?
  locationNote String?

  // --- Provenance -----------------------------------------------------------
  sourceFile    String
  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])

  // The original row, verbatim. Every normalisation this system performs — "OL"
  // to OPEN_CIRCUIT, a rejected year of 19999, a rating of "3*5" — stays
  // reversible because the untouched source is one column away.
  rawRow Json

  // Set when a value could not be trusted: a year of 2811, a G-Number reading
  // "Faded numbers". The row still imports; a human is asked to look.
  needsReview   Boolean  @default(false)
  reviewReasons String[]

  createdAt DateTime @default(now())

  @@index([transformerId, inspectedOn])
  @@index([substationCode])
  @@index([inspectedOn])
  @@index([structure])
  @@index([loadingOk])
  @@index([needsReview])
}

/**
 * One EMDis export. The file header names a substation and a serial but carries
 * NO G-Number, so it can only reach its transformer through the mapping the
 * inspection register provides. That is why inspections must import first.
 */
model EmdisDataset {
  id   String @id @default(cuid())
  name String

  transformerId String?
  transformer   Transformer? @relation(fields: [transformerId], references: [id])
  resolvedBy    MatchMethod  @default(UNRESOLVED)

  // Straight from the seven header lines, kept as recorded.
  substationCode      String?
  serialAsRecorded    String?
  makeAsRecorded      String?
  ratingKvaAsRecorded Int?

  // Everything per-phase is judged against rated current, and rated current
  // depends on the line-to-line voltage. Stored per dataset so an 11 kV feeder
  // and a 415 V board are never silently compared on the same basis.
  nominalVoltLL Float @default(415)

  firstReadingAt  DateTime
  lastReadingAt   DateTime
  readingCount    Int
  intervalSeconds Int

  uploadedById   String
  uploadedByName String

  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])

  createdAt DateTime @default(now())

  readings EmdisReading[]
  hourly   EmdisHourly[]

  @@index([transformerId])
  @@index([substationCode])
}

/**
 * One instant of three-phase measurement.
 * An Int identity, not a cuid: one transformer at 1-minute resolution is about
 * 525,000 rows a year. Raw readings are kept for a rolling window; dashboards
 * read EmdisHourly instead.
 */
model EmdisReading {
  id        Int          @id @default(autoincrement())
  datasetId String
  dataset   EmdisDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  recordedAt DateTime

  // Phase-to-neutral volts
  l1nV Float?
  l2nV Float?
  l3nV Float?

  // Phase currents, and the neutral. A balanced three-phase load carries almost
  // nothing in the neutral, so neutralC reads directly on imbalance and on
  // triplen harmonics returning through it.
  l1c      Float?
  l2c      Float?
  l3c      Float?
  neutralC Float?

  // Line-to-line volts
  l1l2V Float?
  l2l3V Float?
  l3l1V Float?

  kva    Float?
  kw     Float?
  kvar   Float?
  pf     Float?
  hz     Float?
  thdPct Float?
  kwh    Float? // cumulative meter register

  // --- Derived once, at ingest ---------------------------------------------
  // Computed here rather than at query time, because the alternative is
  // recomputing across millions of rows on every dashboard load.
  maxPhaseC         Float?
  phaseUnbalancePct Float? // max deviation from the mean of the three phases
  loadingPct        Float? // measured kVA as a percentage of the nameplate
  maxPhasePctRated  Float? // the figure the kVA number hides
  neutralPctRated   Float?

  @@index([datasetId, recordedAt])
}

/**
 * Hourly rollup. Not an optimisation — the only way the numbers work. A
 * thousand transformers at 1-minute resolution is 525 million rows a year. Raw
 * data answers "what happened at 20:08"; this answers everything else.
 */
model EmdisHourly {
  id String @id @default(cuid())

  datasetId String
  dataset   EmdisDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  transformerId String?
  transformer   Transformer? @relation(fields: [transformerId], references: [id])

  hourStart DateTime
  samples   Int

  avgKva Float?
  maxKva Float?
  p95Kva Float?
  avgKw  Float?
  avgPf  Float?

  avgL1c Float?
  avgL2c Float?
  avgL3c Float?
  maxL1c Float?
  maxL2c Float?
  maxL3c Float?

  avgNeutralC Float?
  maxNeutralC Float?

  avgVoltage Float?
  minVoltage Float?
  maxVoltage Float?

  avgThdPct Float?
  maxThdPct Float?

  avgUnbalancePct Float?
  maxUnbalancePct Float?

  maxLoadingPct    Float?
  maxPhasePctRated Float?

  // Minutes within this hour spent over each threshold. Five minutes at 105%
  // and six hours at 105% are different problems; a peak figure cannot tell
  // them apart and a duration can.
  minutesOver80Pct  Int @default(0)
  minutesOver100Pct Int @default(0)

  @@unique([datasetId, hourStart])
  @@index([transformerId, hourStart])
}

/**
 * Two records of the same transformer that cannot both be true.
 * Raised by the importer, never resolved by it. Import does not get to decide
 * which inspector was right — it surfaces the disagreement, and a named human
 * settles it with a stated reason.
 */
model RecordConflict {
  id String @id @default(cuid())

  transformerId String
  transformer   Transformer @relation(fields: [transformerId], references: [id], onDelete: Cascade)

  field String // "make" | "ratingKva" | "yearOfManufacture"

  valueA  String
  sourceA String // inspection report id / file
  dateA   DateTime?

  valueB  String
  sourceB String
  dateB   DateTime?

  status ConflictStatus @default(OPEN)

  resolvedValue  String?
  resolvedById   String?
  resolvedByUser User?     @relation("ConflictResolver", fields: [resolvedById], references: [id])
  resolvedAt     DateTime?
  resolutionNote String?

  createdAt DateTime @default(now())

  @@index([transformerId, status])
  @@index([status])
}

/**
 * One upload. Makes every import reviewable, attributable and reversible.
 */
model ImportBatch {
  id   String     @id @default(cuid())
  kind ImportKind

  fileName String

  uploadedById   String
  uploadedBy     User   @relation("ImportUploader", fields: [uploadedById], references: [id])
  uploadedByName String

  rowsTotal    Int @default(0)
  rowsImported Int @default(0)
  rowsStaged   Int @default(0) // parsed fine, no transformer to attach to
  rowsRejected Int @default(0) // unreadable
  rowsFlagged  Int @default(0) // imported but needing human review

  notes String?

  createdAt DateTime @default(now())

  inspections   SubstationInspection[]
  emdisDatasets EmdisDataset[]

  @@index([kind, createdAt])
}

/**
 * A saved column-mapping profile.
 * The universal recognizer places most headers on its own, but the first time a
 * new vendor's export arrives an engineer may confirm or correct a column or
 * two. Saving that decision as a named profile means the next file with the same
 * headers is recognised instantly — "George's EMDis v2", applied in one click —
 * instead of re-confirming the same mapping every month.
 */
model ColumnMappingProfile {
  id   String @id @default(cuid())
  name String @unique

  // header (exactly as written in the file) -> canonical field name. Held as
  // JSON so the field vocabulary can grow without a migration; the recognizer
  // owns the list of valid canonical fields.
  mapping Json

  // A fingerprint of the sorted, normalised header set, so a file that matches a
  // saved profile can be spotted before the engineer even names it.
  headerSignature String?

  createdById   String
  createdByName String
  createdAt     DateTime @default(now())
  lastUsedAt    DateTime @default(now())
  timesUsed     Int      @default(0)

  @@index([headerSignature])
}

// ============================================================================
// THE REPAIR AND REPLACEMENT LOOP
//
// A transformer that fails does not simply stop. It is recovered, carried to a
// workshop, opened, diagnosed, and either repaired or condemned. If it is
// condemned, a site somewhere is off supply until a replacement is found,
// allocated and installed — and that waiting period, not the fault itself, is
// what customers actually experience.
//
// This half of the model exists to make that waiting visible.
// ============================================================================

/**
 * One visit to the workshop.
 * Separate from LifecycleEvent because a repair is a PROCESS with a beginning,
 * a middle and an outcome, while an event is an instant. The events record that
 * it arrived and that it left; this records what happened in between, what it
 * cost, and whether it worked.
 */
model RepairRecord {
  id String @id @default(cuid())

  transformerId String
  transformer   Transformer @relation(fields: [transformerId], references: [id], onDelete: Cascade)

  /**
   * The RECEIVED_AT_WORKSHOP event that opened this repair.
   */
  lifecycleEventId String?
  lifecycleEvent   LifecycleEvent? @relation("RepairOpenedBy", fields: [lifecycleEventId], references: [id])

  receivedAtWorkshop DateTime
  workshopName       String?

  /**
   * What the workshop ACTUALLY found, which is frequently not what the field
   * reported. A unit sent in for "oil leak" that turns out to have a shorted
   * winding is the single most useful correction in the whole loop: it tells
   * the fleet what is really killing transformers.
   */
  faultCauseConfirmed String?
  faultCauseReported  String?

  repairActions String? // what was done
  partsReplaced String? // bushings, gaskets, oil, windings

  repairCostKes     Float?
  /**
   * Set when the workshop finishes, successfully or not.
   */
  repairCompletedAt DateTime?

  /**
   * A repaired unit carries a workshop warranty, not the manufacturer's. If it
   * fails inside this window the workshop owes the rework — and without the
   * distinction recorded, that claim is unarguable.
   */
  repairWarrantyMonths Int? @default(3)

  /**
   * IR, WR, oil BDV and ratio measured after the work.
   */
  postRepairTestId String?
  postRepairTest   TestRecord? @relation("PostRepairTest", fields: [postRepairTestId], references: [id])

  repairSuccessful Boolean?
  failureReason    String? // "winding damage too extensive to rewind economically"

  workshopTechnician String?
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([transformerId, receivedAtWorkshop])
  @@index([repairSuccessful])
  @@index([repairCompletedAt])
}

/**
 * A site that needs a transformer and does not have one.
 * This is the part of the cycle paper loses completely. A transformer fails, is
 * carried away, and the site waits — but nothing anywhere holds the fact that
 * customers are off supply, how long they have been off, or who is accountable
 * for ending it. A fault is closed when the unit is recovered; the OUTAGE is
 * not over until something is energised in its place.
 * Raised by a field engineer, approved by a manager, satisfied by an allocation.
 */
model SupplyRequest {
  id String @id @default(cuid())

  /**
   * Short human reference, e.g. SR-2026-0041, for radio and WhatsApp.
   */
  reference String @unique

  // --- Where -------------------------------------------------------------
  siteName       String
  substationCode String?
  region         String?
  county         String?
  lat            Float?
  lng            Float?
  landmark       String?

  // --- What is needed ----------------------------------------------------
  ratingKvaNeeded     Int
  reason              SupplyRequestReason
  /**
   * The unit that failed, when this request replaces one.
   */
  failedTransformerId String?
  failedTransformer   Transformer?        @relation("ReplacementFor", fields: [failedTransformerId], references: [id])

  /**
   * How many customers are off supply. The number that turns an engineering
   * queue into a priority order — 400 households waiting outranks 6.
   */
  customersAffected Int?
  urgency           SupplyUrgency @default(NORMAL)

  // --- Who ---------------------------------------------------------------
  raisedById String
  raisedBy   User     @relation("SupplyRaisedBy", fields: [raisedById], references: [id])
  raisedAt   DateTime @default(now())
  notes      String?

  status SupplyRequestStatus @default(SUBMITTED)

  // --- Approval ----------------------------------------------------------
  // A field engineer reports the need; a manager authorises spending an asset
  // on it. Keeping those separate is what stops the store being emptied by
  // whoever shouts loudest.
  approvedById    String?
  approvedBy      User?     @relation("SupplyApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  approvalNotes   String?
  rejectionReason String?

  allocations Allocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, urgency])
  @@index([region])
  @@index([raisedAt])
}

/**
 * A specific transformer, reserved for a specific site, on a specific date.
 * The reservation is the point. Without it two engineers can be promised the
 * same unit by two different people, and the second one discovers it at the
 * roadside with a crane hired. A transformer is either free or it is spoken
 * for, and the system has to be able to say which.
 */
model Allocation {
  id String @id @default(cuid())

  requestId String
  request   SupplyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  transformerId String
  transformer   Transformer @relation(fields: [transformerId], references: [id])

  allocatedById String
  allocatedBy   User     @relation("AllocatedBy", fields: [allocatedById], references: [id])
  allocatedAt   DateTime @default(now())

  /**
   * When the crew intends to energise it.
   */
  plannedInstallDate DateTime?

  status AllocationStatus @default(RESERVED)

  releasedAt    DateTime?
  releaseReason String?

  /**
   * The INSTALLED event that closed this allocation.
   */
  fulfilledEventId String?
  fulfilledAt      DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One live reservation per transformer. Enforced in the write path rather
  // than by a partial index, because Prisma cannot express "unique where
  // status = RESERVED" portably — see reserveTransformer().
  @@index([transformerId, status])
  @@index([requestId])
  @@index([status, plannedInstallDate])
}

// ============================================================================
// MCP (Model Context Protocol) — read-only analytics access for Claude
// ============================================================================
// Lets an authorised engineer or manager ask Claude natural-language questions
// about the fleet — health, load, warranty, defects — over a small set of
// read-only tools. Three concerns, three tables: who is ALLOWED to connect
// (McpOAuthClient, registered once per client app such as Claude Desktop), who
// HAS connected (McpToken — revocable, and never a bare secret at rest; only
// its id and metadata are stored, the bearer credential itself is a signed
// JWT carrying that id), and what they actually asked (McpAccessLog, the audit
// trail an admin reviews).

/**
 * Singleton row — read via getMcpSettings(), which creates it on first read.
 */
model McpSettings {
  id String @id @default(cuid())

  enabled          Boolean @default(true)
  rateLimitPerHour Int     @default(400)

  // Admin can lock any other role out independently. Admin itself is never
  // gated here — whoever can turn MCP off must always be able to turn it back on.
  managerEnabled       Boolean @default(true)
  storeKeeperEnabled   Boolean @default(true)
  fieldEngineerEnabled Boolean @default(false)

  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("McpSettingsUpdatedBy", fields: [updatedById], references: [id])
}

/**
 * A client app that registered itself via Dynamic Client Registration (RFC 7591) — e.g. Claude Desktop.
 */
model McpOAuthClient {
  id           String   @id @default(cuid()) // this IS the client_id
  clientName   String?
  redirectUris String[] // exact match required at /authorize and /token — the open-redirect guard
  createdAt    DateTime @default(now())

  tokens McpToken[]
}

/**
 * A live access grant. The bearer token handed to the client is a signed JWT
 * embedding this row's id as `jti` — the JWT signature is the actual secret;
 * this row is never a credential by itself, only a revocation and audit handle.
 */
model McpToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("McpTokenIssuedTo", fields: [userId], references: [id])

  clientId String?
  client   McpOAuthClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  kind       McpTokenKind @default(OAUTH)
  label      String?
  expiresAt  DateTime
  revoked    Boolean      @default(false)
  lastUsedAt DateTime?
  createdAt  DateTime     @default(now())

  accessLogs McpAccessLog[]

  @@index([userId])
}

model McpAccessLog {
  id      String    @id @default(cuid())
  userId  String?
  user    User?     @relation("McpAccessLogUser", fields: [userId], references: [id])
  tokenId String?
  token   McpToken? @relation(fields: [tokenId], references: [id], onDelete: SetNull)

  tool         String
  argsSummary  String?
  success      Boolean
  errorMessage String?
  authMethod   McpAuthMethod?

  occurredAt DateTime @default(now())

  @@index([occurredAt])
  @@index([userId])
}
