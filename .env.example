# ---------------------------------------------------------------------------
# Transformer Pulse — environment
#
# Do NOT hand-write these values. Create the database from your Vercel project
# (Storage → Create → Neon), then pull the variables down:
#
#     npx vercel link       # once, connects this folder to the Vercel project
#     npx vercel env pull .env
#
# That keeps local and production reading the same configuration, which is the
# single most common thing that breaks at this stage.
# ---------------------------------------------------------------------------

# Neon gives you two endpoints for the same database. Both are needed.
#
# Pooled (host contains "-pooler"). Used by the running app. Serverless
# functions open and close connections constantly; without the pool we exhaust
# Neon's connection limit.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.c-4.region.aws.neon.tech/neondb?sslmode=require"

# Direct (same host, WITHOUT "-pooler"). Used only by the Prisma CLI for
# migrations. Migrations hold advisory locks across statements, and PgBouncer
# can route each statement to a different backend — which breaks them in
# intermittent, confusing ways.
#
# Careful: the host must keep its routing segment (e.g. ".c-4."). Dropping it
# gives "password authentication failed", which looks like a wrong password but
# is actually a wrong host.
DIRECT_URL="postgresql://user:password@ep-xxx.c-4.region.aws.neon.tech/neondb?sslmode=require"

# Signs the session cookie (JWT). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-me-with-a-long-random-string"

# Public base URL. Used to build the links encoded into QR codes.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Vercel Blob token for field photo uploads. Added automatically when you
# create a Blob store in your Vercel project (Storage → Create → Blob).
BLOB_READ_WRITE_TOKEN=""

# OpenRouteService — turn-by-turn driving directions for in-app navigation.
# Server-side only; never exposed to the browser. Get your own key at
# https://openrouteservice.org/dev/#/signup (free tier: ~2000 requests/day).
ORS_API_KEY=""
