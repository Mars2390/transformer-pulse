# Dependencies — never commit these. They are rebuilt from package.json.
node_modules/

# Next.js build output
.next/
out/
build/
dist/

# Secrets. Ignore EVERY .env variant, then allow the example back in.
# The narrow ".env / .env*.local" pattern misses things like .env.backup and
# .env.production — which is exactly how database passwords reach GitHub.
.env*
!.env.example

# Logs
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS noise
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Prisma 7 generates the client into src/. It is build output, not source —
# regenerated by `prisma generate` in the build script on every deploy.
/src/generated/

# Vercel
.vercel

.vercel
.env*

# --- Real KPLC operational data -------------------------------------------
# Kept locally for development and reference, NEVER committed. These files are
# live utility data: transformer serials, GPS-adjacent site descriptions, staff
# numbers of named inspectors, and load telemetry for real customers. Pushing
# them puts KPLC data in a public git history that cannot be un-published.
#
# Import them through the app instead — the database is the right home.
KPLC.csv
KPLC.xlsx
*EMDIS*.csv
*EMDIS*.xlsx
*INSPECTION*.csv
*INSPECTION*.xlsx
*SUBSTATION*.csv
*SUBSTATION*.xlsx
nairobi-sites.csv
/data/
