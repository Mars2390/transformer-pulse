# Dependencies — never commit these. They are rebuilt from package.json.
node_modules/

# Next.js build output
.next/
out/
build/
dist/

# Secrets. Ignore EVERY .env variant, then allow the example back in.
# The narrow ".env / .env*.local" pattern misses things like .env.backup and
# .env.production — which is exactly how database passwords reach GitHub.
.env*
!.env.example

# Logs
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS noise
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Prisma 7 generates the client into src/. It is build output, not source —
# regenerated by `prisma generate` in the build script on every deploy.
/src/generated/

# Vercel
.vercel
